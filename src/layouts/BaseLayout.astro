---
import "@fontsource/geist-sans/400.css"
import "@fontsource/geist-sans/500.css"
import "@fontsource/geist-sans/600.css"
import "@fontsource/geist-sans/700.css"
import "@fontsource/geist-mono/400.css"
import "../styles/global.css"

import { getLangFromUrl } from "@i18n/utils"
import { buildSeo, personSchema, websiteSchema } from "@lib/seo"
import { alternateLangPath } from "@i18n/utils"
import { site } from "@data/site"

interface Props {
	title?: string
	description?: string
}

const { title, description } = Astro.props
const lang = getLangFromUrl(Astro.url)
const seo = buildSeo({ lang, title, description, path: Astro.url.pathname })
const enHref = new URL(alternateLangPath(Astro.url, "en"), site.url).href
const deHref = new URL(alternateLangPath(Astro.url, "de"), site.url).href
const schema = [personSchema(), websiteSchema()]
---

<!doctype html>
<html lang={lang} data-theme="dark" class="no-js">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Favicon package -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{seo.title}</title>
		<meta name="description" content={seo.description} />
		<link rel="canonical" href={seo.canonical} />
		<meta name="author" content={site.fullName} />
		<meta
			name="keywords"
			content="Amirmohammad Eftekhari, Fachinformatiker, IT, Linux, Networking, Infrastructure, Automation, Ausbildung"
		/>

		<!-- Language alternates -->
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="de" href={deHref} />
		<link rel="alternate" hreflang="x-default" href={enHref} />

		<!-- Open Graph (spec 09 §11) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={seo.title} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:url" content={seo.canonical} />
		<meta property="og:image" content={seo.ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={seo.locale} />
		<meta property="og:site_name" content={site.name} />

		<!-- Twitter/X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seo.title} />
		<meta name="twitter:description" content={seo.description} />
		<meta name="twitter:image" content={seo.ogImage} />

		<meta name="theme-color" content="#0A0A0A" />

		<!-- Prevent theme flash: run before paint -->
		<script is:inline>
			;(function () {
				const root = document.documentElement
				root.classList.remove("no-js")
				root.setAttribute("data-theme", "dark")
			})()
		</script>

		<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
		>
			Skip to content
		</a>
		<slot />

		<!-- Scroll reveal (IntersectionObserver, reduced-motion aware) -->
		<script>
			import "../lib/reveal.ts"
		</script>
	</body>
</html>
