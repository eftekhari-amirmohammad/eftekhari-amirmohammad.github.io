---
interface Props {
	kicker: string
	title: string
	align?: "left" | "center"
	class?: string
}

const { kicker, title, align = "left", class: className = "" } = Astro.props
const alignment = align === "center" ? "items-center text-center" : "items-start text-left"
---

<div class={`reveal flex flex-col gap-3 ${alignment} ${className}`}>
	<span class="flex items-center gap-2 text-sm font-medium text-accent">
		<span class="h-px w-6 bg-accent/50"></span>
		{kicker}
	</span>
	<h2 class="text-3xl font-semibold sm:text-4xl md:text-[2.75rem] md:leading-[1.1]">
		{title}
	</h2>
</div>
