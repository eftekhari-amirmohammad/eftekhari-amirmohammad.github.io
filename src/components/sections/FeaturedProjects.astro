---
import SectionTitle from "@components/ui/SectionTitle.astro"
import Icon from "@components/ui/Icon.astro"
import { getLangFromUrl, useTranslations } from "@i18n/utils"
import { getProjects } from "@lib/github"
import type { IconName } from "@lib/icons"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Projects are pulled live from GitHub at build time (newest first), with the
// curated list in @data/projects as an offline fallback (see src/lib/github.ts).
const ordered = await getProjects()
---

<section id="projects" class="section relative">
	<div class="container-page flex flex-col gap-12">
		<SectionTitle kicker={t("projects.kicker")} title={t("projects.title")} />

		<div class="grid gap-5 md:grid-cols-2">
			{
				ordered.map((p, i) => (
					<article
						class="reveal card card-hover group relative flex flex-col gap-5 overflow-hidden"
						data-reveal-delay={(i % 2) * 80}
					>
						{/* Decorative gradient corner */}
						<div
							class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-accent/10 blur-2xl transition-opacity duration-500 group-hover:opacity-100 opacity-40"
							aria-hidden="true"
						/>

						<div class="relative flex items-start justify-between gap-4">
							<span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/12 text-accent">
								<Icon name={p.icon as IconName} size={24} />
							</span>
							{p.status === "coming-soon" ? (
								<span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
									<span class="h-1.5 w-1.5 rounded-full bg-accent" />
									{t("projects.comingSoon")}
								</span>
							) : (
								<span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-white/[0.03] px-3 py-1 text-xs font-medium text-ink-secondary">
									<span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
									Live
								</span>
							)}
						</div>

						<div class="relative flex flex-col gap-2">
							<span class="text-xs font-medium uppercase tracking-wide text-accent">
								{p.category[lang]}
							</span>
							<h3 class="text-xl font-semibold">{p.title}</h3>
							<p class="text-sm leading-relaxed text-ink-secondary">{p.description[lang]}</p>
						</div>

						<div class="relative flex flex-wrap gap-1.5">
							{p.tech.map((tech) => (
								<span class="tag">{tech}</span>
							))}
						</div>

						{p.github && (
							<div class="relative mt-auto flex items-center gap-4 pt-1">
								<a
									href={p.github}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-secondary transition-colors hover:text-accent"
								>
									<Icon name="github" size={16} />
									{t("projects.viewCode")}
								</a>
							</div>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>
