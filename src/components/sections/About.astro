---
import SectionTitle from "@components/ui/SectionTitle.astro"
import Icon from "@components/ui/Icon.astro"
import { getLangFromUrl, useTranslations } from "@i18n/utils"

const t = useTranslations(getLangFromUrl(Astro.url))

const highlights = [
	{ icon: "target", label: { key: "goal" } },
] as const
---

<section id="about" class="section relative">
	<div class="container-page">
		<div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
			<SectionTitle kicker={t("about.kicker")} title={t("about.title")} />

			<div class="flex flex-col gap-6">
				<p class="reveal text-lg leading-relaxed text-ink-secondary" data-reveal-delay="60">
					{t("about.p1")}
				</p>
				<p class="reveal text-lg leading-relaxed text-ink-secondary" data-reveal-delay="120">
					{t("about.p2")}
				</p>

				<div class="reveal mt-2 flex items-center gap-3 rounded-2xl border border-hairline bg-accent/[0.06] p-4" data-reveal-delay="180">
					<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15 text-accent">
						<Icon name="target" size={20} />
					</span>
					<p class="text-sm text-ink-secondary">
						<span class="font-medium text-ink">Ausbildung:</span>
						Fachinformatiker — Germany.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
